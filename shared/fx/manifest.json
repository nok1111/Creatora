{
  "version": 1,
  "eases": {
    "linear": "{u}",
    "easeIn": "({u}*{u})",
    "easeOut": "(1-(1-{u})*(1-{u}))",
    "easeInOut": "({u}*{u}*(3-2*{u}))",
    "easeInCubic": "({u}*{u}*{u})",
    "easeOutCubic": "(1-pow(1-{u},3))",
    "easeInOutCubic": "if(lt({u},0.5),4*{u}*{u}*{u},1-pow(2-2*{u},3)/2)",
    "easeOutExpo": "if(eq({u},1),1,1-pow(2,0-10*{u}))"
  },
  "capabilities": {
    "beats": true,
    "subjectMask": false
  },
  "entries": [
    {
      "id": "velocitySwipe",
      "kind": "transition",
      "category": "transitions",
      "name": "Velocity Swipe",
      "description": "Fast whip-pan to the next clip with directional motion blur that peaks mid-swipe.",
      "params": [
        {
          "key": "direction",
          "label": "Direction",
          "type": "enum",
          "def": 0,
          "options": [
            "Left",
            "Right",
            "Up",
            "Down"
          ]
        },
        {
          "key": "blur",
          "label": "Motion blur",
          "type": "number",
          "def": 0.16,
          "min": 0,
          "max": 0.4,
          "step": 0.01
        }
      ],
      "derive": {
        "dx": {
          "from": "direction",
          "values": [
            -1,
            1,
            0,
            0
          ]
        },
        "dy": {
          "from": "direction",
          "values": [
            0,
            0,
            -1,
            1
          ]
        }
      },
      "expr": "(if(between((X+{dx}*W*(-0.5000*{blur}*sin(PI*{T})-{T})),0,W-1)*between((Y+{dy}*H*(-0.5000*{blur}*sin(PI*{T})-{T})),0,H-1),SA((X+{dx}*W*(-0.5000*{blur}*sin(PI*{T})-{T})),(Y+{dy}*H*(-0.5000*{blur}*sin(PI*{T})-{T}))),SB((X+{dx}*W*(-0.5000*{blur}*sin(PI*{T})+1-{T})),(Y+{dy}*H*(-0.5000*{blur}*sin(PI*{T})+1-{T}))))+if(between((X+{dx}*W*(-0.3000*{blur}*sin(PI*{T})-{T})),0,W-1)*between((Y+{dy}*H*(-0.3000*{blur}*sin(PI*{T})-{T})),0,H-1),SA((X+{dx}*W*(-0.3000*{blur}*sin(PI*{T})-{T})),(Y+{dy}*H*(-0.3000*{blur}*sin(PI*{T})-{T}))),SB((X+{dx}*W*(-0.3000*{blur}*sin(PI*{T})+1-{T})),(Y+{dy}*H*(-0.3000*{blur}*sin(PI*{T})+1-{T}))))+if(between((X+{dx}*W*(-0.1000*{blur}*sin(PI*{T})-{T})),0,W-1)*between((Y+{dy}*H*(-0.1000*{blur}*sin(PI*{T})-{T})),0,H-1),SA((X+{dx}*W*(-0.1000*{blur}*sin(PI*{T})-{T})),(Y+{dy}*H*(-0.1000*{blur}*sin(PI*{T})-{T}))),SB((X+{dx}*W*(-0.1000*{blur}*sin(PI*{T})+1-{T})),(Y+{dy}*H*(-0.1000*{blur}*sin(PI*{T})+1-{T}))))+if(between((X+{dx}*W*(0.1000*{blur}*sin(PI*{T})-{T})),0,W-1)*between((Y+{dy}*H*(0.1000*{blur}*sin(PI*{T})-{T})),0,H-1),SA((X+{dx}*W*(0.1000*{blur}*sin(PI*{T})-{T})),(Y+{dy}*H*(0.1000*{blur}*sin(PI*{T})-{T}))),SB((X+{dx}*W*(0.1000*{blur}*sin(PI*{T})+1-{T})),(Y+{dy}*H*(0.1000*{blur}*sin(PI*{T})+1-{T}))))+if(between((X+{dx}*W*(0.3000*{blur}*sin(PI*{T})-{T})),0,W-1)*between((Y+{dy}*H*(0.3000*{blur}*sin(PI*{T})-{T})),0,H-1),SA((X+{dx}*W*(0.3000*{blur}*sin(PI*{T})-{T})),(Y+{dy}*H*(0.3000*{blur}*sin(PI*{T})-{T}))),SB((X+{dx}*W*(0.3000*{blur}*sin(PI*{T})+1-{T})),(Y+{dy}*H*(0.3000*{blur}*sin(PI*{T})+1-{T}))))+if(between((X+{dx}*W*(0.5000*{blur}*sin(PI*{T})-{T})),0,W-1)*between((Y+{dy}*H*(0.5000*{blur}*sin(PI*{T})-{T})),0,H-1),SA((X+{dx}*W*(0.5000*{blur}*sin(PI*{T})-{T})),(Y+{dy}*H*(0.5000*{blur}*sin(PI*{T})-{T}))),SB((X+{dx}*W*(0.5000*{blur}*sin(PI*{T})+1-{T})),(Y+{dy}*H*(0.5000*{blur}*sin(PI*{T})+1-{T})))))/6",
      "render": {
        "kind": "strip"
      },
      "defaultDurationMs": 500,
      "defaultEase": "easeInOutCubic",
      "preview": "gl",
      "thumb": "fxt-swipe"
    },
    {
      "id": "liquidMelt",
      "kind": "transition",
      "category": "transitions",
      "name": "Liquid Melt",
      "description": "The outgoing clip melts downward in wavy drips, revealing the next clip underneath.",
      "params": [
        {
          "key": "drip",
          "label": "Drip length",
          "type": "number",
          "def": 0.6,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "key": "wave",
          "label": "Wave",
          "type": "number",
          "def": 0.06,
          "min": 0,
          "max": 0.12,
          "step": 0.005
        },
        {
          "key": "freq",
          "label": "Wave count",
          "type": "number",
          "def": 3,
          "min": 1,
          "max": 8,
          "step": 0.5
        },
        {
          "key": "wobble",
          "label": "Side wobble",
          "type": "number",
          "def": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      ],
      "expr": "(if(lt(((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5))),0),0,clip(((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5)))/0.04,0,1)))*SA(X+({wobble}*0.03*W*exp(0-((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5)))*4.5)*sin(PI*{T})*sin((Y/H)*40+{T}*12)),Y-({drip}*0.5*H*exp(0-((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5)))*4.5)*sin(PI*{T})*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3))))+(1-(if(lt(((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5))),0),0,clip(((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5)))/0.04,0,1))))*SB(X,Y)",
      "render": {
        "kind": "fields",
        "div": 8,
        "fields": {
          "ax": "X+({wobble}*0.03*W*exp(0-((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5)))*4.5)*sin(PI*{T})*sin((Y/H)*40+{T}*12))",
          "ay": "Y-({drip}*0.5*H*exp(0-((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5)))*4.5)*sin(PI*{T})*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))",
          "m": "if(lt(((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5))),0),0,clip(((Y/H)-({T}*(1.5+{drip}*0.5+{drip}*0.3*(0.5+0.5*sin((X/W)*37.7)*sin((X/W)*11.3+1.3)))-0.25+{wave}*sin((X/W)*{freq}*6.2832+{T}*5)))/0.04,0,1))"
        }
      },
      "defaultDurationMs": 900,
      "defaultEase": "easeInOut",
      "preview": "gl",
      "thumb": "fxt-melt"
    },
